# EchoLearn — Environment Variables
#
# Copy this file to .env and fill in your Supabase values.
# NEVER commit .env to version control.
#
# You can find these values in your Supabase project:
# Settings → API → Project URL and Project API Keys (anon/public key only)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# SECURITY: Never put your service_role key here.
# The service_role key grants admin access and must only be used server-side.
